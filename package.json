  "scripts": {
    "start": "wrangler dev",
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "test": "mocha --experimental-loader ./test/loader.js",
    "test:unit": "mocha test/unit/*.test.js",
    "lint": "eslint src/ --ext .js",
    "format": "prettier --write src/ public/"
  },
  "author": "BrainSAIT-LTD",
  "license": "GPL-3.0",
  "dependencies": {
    "chart.js": "^3.9.1",
    "exceljs": "^4.3.0",
    "itty-router": "^3.0.12",
    "openai": "^4.12.1",
    "pdf-parse": "^1.1.1",
    "simple-statistics": "^7.8.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250628.0",
    "eslint": "^8.57.0",
    "mocha": "^11.7.1",
    "prettier": "^3.2.5",
    "wrangler": "^4.22.0"
  },
  "keywords": [
    "healthcare",
    "insurance",
    "data analysis",
    "cloudflare workers"
